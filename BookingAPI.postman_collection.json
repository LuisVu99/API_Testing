                "exec": [
                  "// 1. Status code\r",
                  "pm.test(\"Status code is 200\", function () {\r",
                  "    pm.expect(pm.response.code).to.equal(200);\r",
                  "});\r",
                  "\r",
                  "// 2. Check response time\r",
                  "pm.test(\"Response time is less than 300ms\", function () {\r",
                  "    pm.expect(pm.response.responseTime).to.be.below(1000);\r",
                  "});\r",
                  "\r",
                  "// 3. Response contain\r",
                  "pm.test(\"Response body contains 'Eric'\", function () {\r",
                  "    pm.expect(pm.response.text()).to.include(\"Lan\");\r",
                  "});\r",
                  "\r",
                  "// 4. get content type\r",
                  "pm.test(\"Content-Type is application/json\", function () {\r",
                  "    pm.expect(pm.response.headers.get(\"Content-Type\")).to.include(\"application/json\");\r",
                  "});\r",
                  "\r",
                  "// 5. Check data type\r",
                  "pm.test(\"Check data type\", function() {\r",
                  "    var jsonData = pm.response.json();\r",
                  "    pm.expect(jsonData.booking.bookingdates.checkin).to.be.a('string')\r",
                  "})\r",
                  "\r",
                  "// // 6. Assert the length of an array\r",
                  "// pm.test(\"Assert the length of an array\", function() {\r",
                  "//     var jsonData = pm.response.json();\r",
                  "//     pm.expect(jsonData.items).to.have.lengthOf(3);\r",
                  "// });\r",
                  "\r",
                  "// 7. Assert a value in response\r",
                  "pm.test(\"Verify value 'name' in response\", function(){\r",
                  "    var jsonData = pm.response.json();\r",
                  "    pm.expect(jsonData.booking.firstname).to.eql(\"Le\");\r",
                  "});\r",
                  "\r",
                  "// Expect result\r",
                  "const firstName_expected = pm.variables.get(\"dataFirstName\");\r",
                  "const lastName_expected = pm.variables.get(\"dataLastName\");\r",
                  "\r",
                  "// Actual result\r",
                  "const jsonData = pm.response.json();\r",
                  "const firstName_actual = jsonData.booking.firstname;\r",
                  "const lastName_actual = jsonData.booking.lastname;\r",
                  "\r",
                  "pm.test(\"First name is correct\", function() {\r",
                  "    pm.expect(firstName_actual, \"Last name is incorrect\").to.eql(firstName_expected)\r",
                  "})\r",
                  "\r",
                  "pm.test(\"Last name is correct\", function() {\r",
                  "    pm.expect(lastName_actual).to.eql(lastName_expected)\r",
                  "})\r",
                  "\r",
                  "const booking = jsonData.bookingid\r",
                  "pm.collectionVariables.set(\"bookingID\",booking)\r",
